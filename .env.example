# Example environment variables for local development.
#
# Copy this file to .env, replace the placeholder secrets, and export the
# variables before running the Controller locally. In production these values
# are injected by the deployment mechanism (Kubernetes secrets, vault, etc.).

# Database
GC_DATABASE_URL=postgresql+asyncpg://controller:controller@localhost:5432/controller

# Required secrets
GC_CONTROLLER_API_SECRET=dev-controller-secret-change-me
GC_EVENT_BRIDGE_SECRET=dev-event-bridge-secret-change-me
GC_EVENT_BRIDGE_HUMAN_SECRET=dev-event-bridge-human-secret-change-me

# Required in production, in addition to GC_CONTROLLER_API_SECRET, to grant
# EXECUTION/MERGE approvals via POST /approvals (#376). Must be issued ONLY
# to the genuine human approval channel (e.g. an admin console or approval
# bot) -- never share it with whatever creates tasks, or this control is
# void. Unset in production means EXECUTION/MERGE approvals are rejected.
GC_HUMAN_APPROVAL_SECRET=dev-human-approval-secret-change-me

# Service-to-service secrets
GC_MACRO_AGENT_API_SECRET=dev-macro-agent-secret-change-me
GC_PLANE_WEBHOOK_SECRET=dev-plane-webhook-secret-change-me
GC_INTAKE_SECRET=dev-intake-secret-change-me

# Optional integrations
GC_PLANE_API_TOKEN=
GC_TELEGRAM_WEBHOOK_SECRET_TOKEN=
GC_OPA_API_TOKEN=

# Optional Plane work-item property UUIDs. Leave empty unless the deployed
# Plane instance supports the documented work-item property API.
GC_PLANE_CONTROLLER_TASK_ID_PROPERTY_ID=
GC_PLANE_OPENTASKS_ID_PROPERTY_ID=
GC_PLANE_SOURCE_PROPERTY_ID=
GC_PLANE_APPROVAL_REQUIRED_PROPERTY_ID=
# JSON mapping from Controller source values to Plane SELECT option UUIDs.
GC_PLANE_SOURCE_OPTION_IDS={}

# Human approvers for EXECUTION/MERGE approvals
GC_ADMINS=

# Required in production: comma-separated allow-list of identities permitted
# to appear as TaskContract.proposed_by. Empty means DENY (fail closed), not
# "no restriction" (#376) -- proposed_by is unauthenticated free text, so an
# unpopulated allow-list leaves every task's proposer identity meaningless
# and no approval can be granted until this is configured.
GC_KNOWN_PROPOSERS=
